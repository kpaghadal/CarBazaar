# Copy to .env and fill in values.

MONGO_URI=mongodb://127.0.0.1:27017/carbazaar
JWT_SECRET=change-this-to-a-long-random-string

PORT=5000

# Optional: public URL of the React app (included in "view your listing" emails)
CLIENT_URL=https://carbazaar-frontend-xqo7.onrender.com

# Gmail — use an App Password (Google Account → Security → 2-Step → App passwords)
# Without these, the API still runs; listing/booking emails are skipped.
EMAIL=your.address@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# Admin bootstrap (used by: node admin_setup.js)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@carbazaar.com
ADMIN_PASSWORD=change-this-admin-password
